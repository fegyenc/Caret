<Window
    x:Class="Typedown.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Typedown.WinUI">

    <Grid>
        <!-- WinUI 3's Window has no Resources property (unlike WPF) — these live on the root Grid
             instead. Folder tree: New File/New Folder/Rename/Delete/Reveal, plus (now) Cut/Copy/
             Paste/Copy as Path and item-to-item drag-drop — see the DragStarting/DragOver/Drop
             handlers and the Cut/Copy/Paste region in MainWindow.xaml.cs. The flyout inherits its
             DataContext from whichever TreeViewItem it opened on, same as the original.
             RootContextFlyout is the TreeView's own background flyout (empty space, not any
             particular row) — ported from the original's separate TreeViewContextFlyout, since
             without it there's no way to create a file/paste into the top level of an opened folder
             at all (every other New File/New Folder/Paste is scoped to a specific row's folder). -->
        <Grid.Resources>
            <MenuFlyout x:Key="RootContextFlyout" Opening="RootContextFlyout_Opening">
                <MenuFlyoutItem Text="New File" Click="NewFileRootContext_Click"/>
                <MenuFlyoutItem Text="New Folder" Click="NewFolderRootContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Paste" Click="PasteRootContext_Click"/>
            </MenuFlyout>
            <MenuFlyout x:Key="FolderContextFlyout">
                <MenuFlyoutItem Text="New File" Click="NewFileContext_Click"/>
                <MenuFlyoutItem Text="New Folder" Click="NewFolderContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Cut" Click="CutContext_Click"/>
                <MenuFlyoutItem Text="Copy" Click="CopyContext_Click"/>
                <MenuFlyoutItem Text="Paste" Click="PasteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Copy as Path" Click="CopyAsPathContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Rename" Click="RenameContext_Click"/>
                <MenuFlyoutItem Text="Delete" Click="DeleteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Reveal in File Explorer" Click="RevealContext_Click"/>
            </MenuFlyout>
            <MenuFlyout x:Key="FileContextFlyout">
                <MenuFlyoutItem Text="Open" Click="OpenContext_Click"/>
                <MenuFlyoutItem Text="Open in New Window" Click="OpenInNewWindowContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Cut" Click="CutContext_Click"/>
                <MenuFlyoutItem Text="Copy" Click="CopyContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Copy as Path" Click="CopyAsPathContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Rename" Click="RenameContext_Click"/>
                <MenuFlyoutItem Text="Delete" Click="DeleteContext_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Reveal in File Explorer" Click="RevealContext_Click"/>
            </MenuFlyout>
            <DataTemplate x:Key="FolderItemTemplate">
                <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              ContextFlyout="{StaticResource FolderContextFlyout}"
                              AutomationProperties.Name="{Binding Name}"
                              CanDrag="True" DragStarting="FolderTreeItem_DragStarting"
                              AllowDrop="True" DragOver="FolderTreeItem_DragOver" Drop="FolderTreeItem_Drop">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="14" Glyph="&#xf12b;" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </TreeViewItem>
            </DataTemplate>
            <DataTemplate x:Key="FileItemTemplate">
                <TreeViewItem ContextFlyout="{StaticResource FileContextFlyout}" IsSelected="{Binding IsSelected, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Name}"
                              CanDrag="True" DragStarting="FolderTreeItem_DragStarting"
                              AllowDrop="True" DragOver="FolderTreeItem_DragOver" Drop="FolderTreeItem_Drop">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="14" Glyph="&#xe8a5;" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </TreeViewItem>
            </DataTemplate>
            <local:ExplorerItemTemplateSelector x:Key="ExplorerItemTemplateSelector"
                FolderTemplate="{StaticResource FolderItemTemplate}" FileTemplate="{StaticResource FileItemTemplate}"/>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: WinUI 3's native ExtendsContentIntoTitleBar + SetTitleBar, not a port
             of Caption.xaml (that used a private Typedown.XamlUI NuGet package for drag/caption-button
             handling we don't have source for, and a full AppViewModel we haven't built). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <TextBlock x:Name="TitleTextBlock" Text="Caret" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Grid>

        <!-- Reduced menu: only File actions that have a real, working implementation behind them
             (New/Open/Save/SaveAs/Exit), plus Find which drives the floating panel below.
             Paragraph/Format/View and most of Edit are deferred — they need EditorViewModel/
             UIViewModel ported first (more #2/#3 work). -->
        <MenuBar x:Name="AppMenuBar" Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="NewMenuItem" Text="New" Click="NewMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open..." Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenFolderMenuItem" Text="Open Folder..." Click="OpenFolderMenuItem_Click"/>
                <MenuFlyoutItem x:Name="NewWindowMenuItem" Text="New Window" Click="NewWindowMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="OpenRecentMenu" Text="Open Recent">
                    <MenuFlyoutItem Text="No Recent Files" IsEnabled="False"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save" Click="SaveMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Save As..." Click="SaveAsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutSubItem x:Name="ExportMenu" Text="Export">
                    <MenuFlyoutItem x:Name="ExportHtmlMenuItem" Text="HTML..." Click="ExportHtmlMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="ExportPdfMenuItem" Text="PDF..." Click="ExportPdfMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="ExportTextMenuItem" Text="Plain Text..." Click="ExportTextMenuItem_Click"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="PrintMenuItem" Text="Print..." Click="PrintMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="P" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings..." Click="SettingsMenuItem_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="FindMenuItem" Text="Find &amp; Replace" Click="FindMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="InsertImageMenuItem" Text="Insert Image..." Click="InsertImageMenuItem_Click"/>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="TocMenuItem" Text="Table of Contents" IsChecked="True" Click="TocMenuItem_Click"/>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Reimplemented, not ported: the original LeftPane split Folder and Contents (TOC) into
                 separate NavigationView-hosted pages (FolderPage/TocPage) switched by a pivot, both
                 bound through a full AppViewModel. This stacks them in one column instead — Folder
                 section only appears once a folder's been opened. -->
            <Border Grid.Column="0" x:Name="TocPane" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Ported (structurally) from Typedown.Core\Controls\SidePaneControls\Pages\
                         FolderPage.xaml: a real ExplorerItem tree bound the same way — TreeView.
                         ItemsSource is the root item's Children (the root itself is never shown), a
                         DataTemplateSelector swaps between folder/file row templates, each folder
                         row's own ItemsSource is its Children for recursive nesting. Live file-system
                         watching and expand/collapse, drag-drop, and clipboard cut/copy/paste all
                         work now — see MainWindow.xaml.cs. CanDragItems/AllowDrop are deliberately
                         left off the TreeView itself (default false, same as the original): dragging
                         and dropping is handled per-item, on each TreeViewItem in the templates
                         above, not through the TreeView's own built-in same-list reorder. -->
                    <StackPanel Grid.Row="0" x:Name="FolderSection" Visibility="Collapsed">
                        <TextBlock x:Name="FolderHeaderText" Margin="8,8,8,4" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        <TreeView x:Name="FolderTreeView" MaxHeight="300"
                                  ItemTemplateSelector="{StaticResource ExplorerItemTemplateSelector}"
                                  ItemInvoked="FolderTreeView_ItemInvoked"
                                  ContextFlyout="{StaticResource RootContextFlyout}"/>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Reimplemented, not ported: the original LeftPane/TocPage used a nested TreeView
                         bound through EditorViewModel.Toc (an ObservableCollection tree built from the
                         editor's StateChange messages) via a full AppViewModel DataContext. This is a
                         flat, indented ListView fed directly from the same StateChange.toc data over
                         our EventCenter, and it sends the same ScrollTo {slug} message the original's
                         JumpBySlug did — traced from EditorViewModel.cs and confirmed against
                         Muya/index.tsx's ScrollTo listener. -->
                    <ListView Grid.Row="1" x:Name="TocListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TocListView_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Content}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
            <WebView2 x:Name="EditorView"/>

            <!-- Reimplemented, not ported: the original FindReplace.xaml used a ThemeShadow +
                 GridSplitter-resizable floating panel bound through FloatViewModel/EditorViewModel/
                 AppViewModel, none of which exist yet. The actual search/highlight/replace logic
                 lives entirely in the web editor (Muya) already — this panel is just an input bar
                 that speaks the same Search/Find/Replace/SearchOpenChange wire messages the original
                 native side sent, traced from Typedown.Editor/src/components/Muya/index.tsx. -->
            <Border x:Name="FindReplacePanel" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16" MinWidth="480" Padding="8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindTextBox" PlaceholderText="Find" KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged"/>
                        <Button Grid.Column="1" Content="&#x2193;" Click="FindNext_Click" ToolTipService.ToolTip="Find next"/>
                        <Button Grid.Column="2" Content="&#x2191;" Click="FindPrev_Click" ToolTipService.ToolTip="Find previous"/>
                        <Button Grid.Column="3" Content="&#x2715;" Click="CloseFind_Click" ToolTipService.ToolTip="Close"/>
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox" PlaceholderText="Replace"/>
                        <Button Grid.Column="1" Content="Replace" Click="Replace_Click"/>
                        <Button Grid.Column="2" Content="Replace All" Click="ReplaceAll_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="WholeWordCheck" Content="Whole word" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="RegexCheck" Content="Regex" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- Reimplemented, not ported: the original SettingsPage was a NavigationView + Frame with
             separate pages (General/Editor/Export/Image/Shortcut/Upload/About/View) built from custom
             ExpanderSettingItem/NormalSettingItem/PathPickerButton controls we don't have. This is one
             ContentDialog covering the settings most worth having now — real values, real persistence
             via SettingsViewModel, and FontSize/LineHeight/TabSize/EditorAreaWidth push live to the
             editor through the same SettingsChanged mechanism the original used (they're in
             SettingsViewModel's notifySet). Export/Image/Shortcut/Upload settings are still TODO —
             they need ExportConfig/ImageUploadConfig/shortcut infrastructure that isn't ported yet. -->
        <ContentDialog x:Name="SettingsDialog" Title="Settings" PrimaryButtonText="Close" DefaultButton="Primary">
            <ScrollViewer MaxHeight="420">
                <StackPanel Spacing="16" MinWidth="360">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Theme"/>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Use system setting" Tag="Default"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoSaveToggle" Header="Auto save" Toggled="AutoSaveToggle_Toggled"/>
                    <ToggleSwitch x:Name="AnimationToggle" Header="Animations" Toggled="AnimationToggle_Toggled"/>
                    <ToggleSwitch x:Name="UseMicaToggle" Header="Use Mica material" Toggled="UseMicaToggle_Toggled"/>
                    <ToggleSwitch x:Name="UseEditorMicaToggle" Header="Use Mica behind editor content" Toggled="UseEditorMicaToggle_Toggled"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Font size"/>
                        <NumberBox x:Name="FontSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="8" Maximum="72" ValueChanged="FontSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Line height"/>
                        <NumberBox x:Name="LineHeightBox" SpinButtonPlacementMode="Inline" SmallChange="0.1" Minimum="1" Maximum="3" ValueChanged="LineHeightBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tab size"/>
                        <NumberBox x:Name="TabSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="1" Maximum="16" ValueChanged="TabSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Editor area width (CSS value, e.g. 1200px)"/>
                        <TextBox x:Name="EditorAreaWidthBox" TextChanged="EditorAreaWidthBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Reused for New File / New Folder / Rename in the folder tree's context menu — one TextBox
             ContentDialog rather than the original's inline TreeViewItem-embedded rename TextBox
             (FindName-swapping a TextBlock for a TextBox inside a recycled DataTemplate is fragile
             without x:Bind's named-element guarantees this project doesn't use). Title/PrimaryButtonText
             and the TextBox's starting text are set from code before ShowAsync. -->
        <ContentDialog x:Name="TextInputDialog" PrimaryButtonText="OK" CloseButtonText="Cancel" DefaultButton="Primary">
            <TextBox x:Name="TextInputBox" AcceptsReturn="False"/>
        </ContentDialog>
    </Grid>
</Window>
