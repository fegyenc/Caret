<Window
    x:Class="Typedown.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: WinUI 3's native ExtendsContentIntoTitleBar + SetTitleBar, not a port
             of Caption.xaml (that used a private Typedown.XamlUI NuGet package for drag/caption-button
             handling we don't have source for, and a full AppViewModel we haven't built). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <TextBlock x:Name="TitleTextBlock" Text="Caret" VerticalAlignment="Center" Margin="12,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Grid>

        <!-- Reduced menu: only File actions that have a real, working implementation behind them
             (New/Open/Save/SaveAs/Exit), plus Find which drives the floating panel below.
             Paragraph/Format/View and most of Edit are deferred — they need EditorViewModel/
             UIViewModel ported first (more #2/#3 work). -->
        <MenuBar x:Name="AppMenuBar" Grid.Row="1">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="NewMenuItem" Text="New" Click="NewMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open..." Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem x:Name="OpenRecentMenu" Text="Open Recent">
                    <MenuFlyoutItem Text="No Recent Files" IsEnabled="False"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save" Click="SaveMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Save As..." Click="SaveAsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings..." Click="SettingsMenuItem_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="FindMenuItem" Text="Find &amp; Replace" Click="FindMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="View">
                <ToggleMenuFlyoutItem x:Name="TocMenuItem" Text="Table of Contents" IsChecked="True" Click="TocMenuItem_Click"/>
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Reimplemented, not ported: the original LeftPane/TocPage used a nested TreeView bound
                 through EditorViewModel.Toc (an ObservableCollection tree built from the editor's
                 StateChange messages) via a full AppViewModel DataContext. This is a flat, indented
                 ListView fed directly from the same StateChange.toc data over our EventCenter, and it
                 sends the same ScrollTo {slug} message the original's JumpBySlug did — traced from
                 EditorViewModel.cs and confirmed against Muya/index.tsx's ScrollTo listener. -->
            <Border Grid.Column="0" x:Name="TocPane" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <ListView x:Name="TocListView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TocListView_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Content}" Margin="{Binding Indent}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Grid.Column="1">
            <WebView2 x:Name="EditorView"/>

            <!-- Reimplemented, not ported: the original FindReplace.xaml used a ThemeShadow +
                 GridSplitter-resizable floating panel bound through FloatViewModel/EditorViewModel/
                 AppViewModel, none of which exist yet. The actual search/highlight/replace logic
                 lives entirely in the web editor (Muya) already — this panel is just an input bar
                 that speaks the same Search/Find/Replace/SearchOpenChange wire messages the original
                 native side sent, traced from Typedown.Editor/src/components/Muya/index.tsx. -->
            <Border x:Name="FindReplacePanel" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16" MinWidth="480" Padding="8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FindTextBox" PlaceholderText="Find" KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged"/>
                        <Button Grid.Column="1" Content="&#x2193;" Click="FindNext_Click" ToolTipService.ToolTip="Find next"/>
                        <Button Grid.Column="2" Content="&#x2191;" Click="FindPrev_Click" ToolTipService.ToolTip="Find previous"/>
                        <Button Grid.Column="3" Content="&#x2715;" Click="CloseFind_Click" ToolTipService.ToolTip="Close"/>
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReplaceTextBox" PlaceholderText="Replace"/>
                        <Button Grid.Column="1" Content="Replace" Click="Replace_Click"/>
                        <Button Grid.Column="2" Content="Replace All" Click="ReplaceAll_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="CaseSensitiveCheck" Content="Case sensitive" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="WholeWordCheck" Content="Whole word" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                        <CheckBox x:Name="RegexCheck" Content="Regex" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- Reimplemented, not ported: the original SettingsPage was a NavigationView + Frame with
             separate pages (General/Editor/Export/Image/Shortcut/Upload/About/View) built from custom
             ExpanderSettingItem/NormalSettingItem/PathPickerButton controls we don't have. This is one
             ContentDialog covering the settings most worth having now — real values, real persistence
             via SettingsViewModel, and FontSize/LineHeight/TabSize/EditorAreaWidth push live to the
             editor through the same SettingsChanged mechanism the original used (they're in
             SettingsViewModel's notifySet). Export/Image/Shortcut/Upload settings are still TODO —
             they need ExportConfig/ImageUploadConfig/shortcut infrastructure that isn't ported yet. -->
        <ContentDialog x:Name="SettingsDialog" Title="Settings" PrimaryButtonText="Close" DefaultButton="Primary">
            <ScrollViewer MaxHeight="420">
                <StackPanel Spacing="16" MinWidth="360">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Theme"/>
                        <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Use system setting" Tag="Default"/>
                            <ComboBoxItem Content="Light" Tag="Light"/>
                            <ComboBoxItem Content="Dark" Tag="Dark"/>
                        </ComboBox>
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoSaveToggle" Header="Auto save" Toggled="AutoSaveToggle_Toggled"/>
                    <ToggleSwitch x:Name="AnimationToggle" Header="Animations" Toggled="AnimationToggle_Toggled"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Font size"/>
                        <NumberBox x:Name="FontSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="8" Maximum="72" ValueChanged="FontSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Line height"/>
                        <NumberBox x:Name="LineHeightBox" SpinButtonPlacementMode="Inline" SmallChange="0.1" Minimum="1" Maximum="3" ValueChanged="LineHeightBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tab size"/>
                        <NumberBox x:Name="TabSizeBox" SpinButtonPlacementMode="Inline" SmallChange="1" Minimum="1" Maximum="16" ValueChanged="TabSizeBox_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Editor area width (CSS value, e.g. 1200px)"/>
                        <TextBox x:Name="EditorAreaWidthBox" TextChanged="EditorAreaWidthBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>
